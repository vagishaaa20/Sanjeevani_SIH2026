# WhatsApp Integration — environment variables
# Add these to .env (not committed to git)

# ── Meta WhatsApp Business Cloud API ──────────────────────────────────────────
WA_CLOUD_API_TOKEN=          # Permanent access token from Meta Business Manager
WA_PHONE_NUMBER_ID=          # Numeric phone number ID (not the phone number itself)
WA_WEBHOOK_VERIFY_TOKEN=     # Arbitrary secret used in webhook handshake
WA_API_VERSION=v20.0         # Graph API version

# ── Bot toggle ─────────────────────────────────────────────────────────────────
WHATSAPP_BOT_ENABLED=true    # Set to false to disable bot without redeploy

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Gemini (backend triage service — different from VITE_ frontend key) ────────
GEMINI_API_KEY=              # Server-side Gemini API key (never sent to browser)

# ── WhatsApp frontend fallback link ───────────────────────────────────────────
VITE_WA_BUSINESS_NUMBER=91XXXXXXXXXX   # E.164 without + (used in WhatsAppModal fallback link)
